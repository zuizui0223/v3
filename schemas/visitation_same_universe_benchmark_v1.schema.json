{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zuizui0223/v3/schemas/visitation_same_universe_benchmark_v1.schema.json",
  "title": "Same-universe flower-visitation benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "opportunity_cadence_seconds",
    "audit_window_probes",
    "audit_sampling",
    "primary_source_id",
    "biological_truth_source_id",
    "reference_candidates",
    "selection_policies",
    "split",
    "freeze",
    "failure_diagnosis",
    "live_adaptive_enabled"
  ],
  "properties": {
    "schema": {"const": "visitation-same-universe-benchmark-v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "opportunity_cadence_seconds": {"type": "number", "exclusiveMinimum": 0},
    "audit_window_probes": {"type": "integer", "minimum": 3},
    "audit_sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "q_selected", "q_omitted"],
      "properties": {
        "seed": {"type": "string", "minLength": 1},
        "q_selected": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "q_omitted": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "primary_source_id": {"type": "string", "minLength": 1},
    "biological_truth_source_id": {"type": "string", "minLength": 1},
    "failure_diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "physical_truth_source_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "reference_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference_id", "source_id", "reference_type", "acquired_before_selection"],
        "properties": {
          "reference_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "reference_type": {
            "type": "string",
            "enum": ["image_roi", "image_stream", "illumination", "inertial", "environmental", "other"]
          },
          "acquired_before_selection": {"const": true}
        }
      }
    },
    "selection_policies": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "policy_class", "shadow_only"],
        "properties": {
          "policy_id": {"type": "string", "minLength": 1},
          "policy_class": {
            "type": "string",
            "enum": ["fixed_scheduled", "any_motion_adaptive", "nuisance_filtered_adaptive", "other"]
          },
          "shadow_only": {"const": true}
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grouping_field", "development_group_ids", "heldout_group_ids"],
      "properties": {
        "grouping_field": {"type": "string", "minLength": 1},
        "development_group_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "heldout_group_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_representation_version",
        "reference_preprocessing_version",
        "policy_version",
        "semantic_mapping_version",
        "truth_rubric_version",
        "estimand_version"
      ],
      "properties": {
        "primary_representation_version": {"type": "string", "minLength": 1},
        "reference_preprocessing_version": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "semantic_mapping_version": {"type": "string", "minLength": 1},
        "truth_rubric_version": {"type": "string", "minLength": 1},
        "estimand_version": {"type": "string", "minLength": 1}
      }
    },
    "live_adaptive_enabled": {"const": false}
  }
}
